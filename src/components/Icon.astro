  bowl: ['M3 11h18c-1 7-5 9-9 9s-8-2-9-9Z', 'M6 4v3', 'M12 2v5', 'M18 4v3', 'M8 22h8'],
  roll: ['M3 9c0-7 18-7 18 0v8c0 7-18 7-18 0Z', 'M3 9c0 7 18 7 18 0', 'M9 8c0-2 6-2 6 0s-6 2-6 0'],
  fish: ['M4 12c7-12 13-6 16 0-3 6-9 12-16 0Z', 'm4 12-3-4v8Z', 'M15 9v.1'],
  cup: ['M5 6h12v11c0 6-12 6-12 0Z', 'M17 8h3c4 0 3 7-3 7', 'M8 2v1', 'M13 2v1'],
